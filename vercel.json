{
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/dl/:pin(\\d{8})",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=FFScanner-:pin.exe"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dl/:pin(\\d{8})",
      "destination": "/FFScanner.exe"
    }
  ]
}
